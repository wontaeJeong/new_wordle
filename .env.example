VITE_APP_TITLE=Daily Lexicon
VITE_BASE_PATH=/
VITE_PUZZLE_EPOCH=2024-01-01
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ENDPOINT=
VITE_ENABLE_ERROR_REPORTING=false
VITE_ERROR_REPORTING_ENDPOINT=
VITE_BUILD_ID=local-build

AUTH_USERNAME=player@example.com
AUTH_PASSWORD_HASH=replace-with-output-from-npm-run-auth-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SECURE_COOKIES=false
AUTH_TRUST_PROXY=false
