# Copy this file to android/keystore.properties and replace the values locally.
# Do not commit android/keystore.properties or the keystore file.

ANDROID_KEYSTORE_PATH=/absolute/path/to/upload-keystore.jks
ANDROID_KEYSTORE_PASSWORD=change-me
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=change-me

# Optional release version overrides.
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0
